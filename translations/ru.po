# ---------------------------------------------------------------------------
# OrphanedTablesForm / OrphanedTablesConfirmForm (routing title "Field
# Explorer: Cleanup" left untranslated, matching this module's existing
# English-title convention for routing/task titles — see "Field Explorer"
# and "Search by entity type" above, which are also routing titles, not
# translated to Russian noun phrases but reused verbatim in Russian UI
# copy elsewhere; only that one title string differs from this pattern
# and is intentionally left as-is since it's a route/tab label, not
# in-page copy).
# ---------------------------------------------------------------------------

msgid "Physical database tables that still exist but are no longer referenced by any field currently tracked on this index — leftovers from fields removed outside the normal cleanup path (config import, direct edits, or heavy field-renaming). Safe to remove; nothing currently reads them."
msgstr "Физические таблицы БД, которые всё ещё существуют, но на них больше не ссылается ни одно поле, отслеживаемое сейчас на этом индексе, — остатки от полей, удалённых в обход штатного механизма очистки (импорт конфигурации, ручные правки или интенсивное переименование полей). Их можно безопасно удалить — сейчас их никто не читает."

msgid "No orphaned tables found for this index."
msgstr "Осиротевших таблиц для этого индекса не найдено."

msgid "Table name"
msgstr "Имя таблицы"

msgid "Row count"
msgstr "Количество строк"

msgid "unknown"
msgstr "неизвестно"

msgid "Delete selected"
msgstr "Удалить выбранные"

msgid "Select at least one table to delete."
msgstr "Выберите хотя бы одну таблицу для удаления."

msgid "No table selection found — select tables to delete first."
msgstr "Не найден список выбранных таблиц — сначала выберите таблицы для удаления."

msgid "Delete this 1 orphaned table?"
msgid_plural "Delete these @count orphaned tables?"
msgstr[0] "Удалить эту осиротевшую таблицу?"
msgstr[1] "Удалить эти @count осиротевшие таблицы?"
msgstr[2] "Удалить эти @count осиротевших таблиц?"

msgid "The following tables will be permanently dropped:"
msgstr "Следующие таблицы будут безвозвратно удалены:"

msgid "Delete"
msgstr "Удалить"

msgid "Confirm table deletion"
msgstr "Подтверждение удаления таблиц"

msgid "Deleted 1 table."
msgid_plural "Deleted @count tables."
msgstr[0] "Удалена 1 таблица."
msgstr[1] "Удалено @count таблицы."
msgstr[2] "Удалено @count таблиц."

msgid "Skipped @count table(s) that were no longer orphaned by the time of deletion (a field was likely re-added in the meantime): @tables"
msgstr "Пропущено таблиц: @count — они больше не были осиротевшими к моменту удаления (вероятно, поле снова добавили тем временем): @tables"
