# ---------------------------------------------------------------------------
# Routing titles, menu links, local tasks
# ---------------------------------------------------------------------------

msgid "Field Explorer"
msgstr "Обозреватель полей"

msgid "Search by entity type"
msgstr "Поиск по типу сущности"

msgid "Field Explorer settings"
msgstr "Настройки обозревателя полей"

msgid "Search API Field Explorer"
msgstr "Search API Field Explorer"

msgid "Search across all configured Search API indexes for property chains leading to a given entity type, and add them as index fields."
msgstr "Поиск по всем настроенным индексам Search API цепочек свойств, ведущих к заданному типу сущности, с возможностью добавить их как поля индекса."

msgid "Configure the maximum property-tree depth and node budget used by Search API Field Explorer."
msgstr "Настройка максимальной глубины дерева свойств и лимита узлов, используемых Search API Field Explorer."

msgid "Settings"
msgstr "Настройки"

# ---------------------------------------------------------------------------
# SettingsForm
# ---------------------------------------------------------------------------

msgid "Maximum property-tree depth"
msgstr "Максимальная глубина дерева свойств"

msgid "How many levels of nested entity references to follow when walking a property tree. Clamped to @min-@max regardless of what is entered here."
msgstr "Сколько уровней вложенных ссылок на сущности проходить при обходе дерева свойств. Значение всегда ограничивается диапазоном @min-@max, что бы здесь ни было введено."

msgid "Node budget per tree walk"
msgstr "Лимит узлов на один обход дерева"

msgid "Maximum number of properties to discover in a single walk before truncating (a safety net against very wide entity/bundle graphs). Clamped to @min-@max."
msgstr "Максимальное число свойств, которые обнаруживаются за один обход, прежде чем результат обрежется (защита от очень широких графов сущностей/типов). Значение всегда ограничивается диапазоном @min-@max."

# ---------------------------------------------------------------------------
# Shared across BrowseIndexForm and SearchByEntityTypeForm
# ---------------------------------------------------------------------------

msgid "Max depth"
msgstr "Макс. глубина"

msgid "General"
msgstr "Общие"

msgid "(already indexed as %field)"
msgstr "(уже проиндексировано как %field)"

msgid "Label"
msgstr "Метка"

msgid "Machine name"
msgstr "Системное имя"

msgid "Property path"
msgstr "Путь свойства"

msgid "Datasource"
msgstr "Источник данных"

msgid "Type"
msgstr "Тип"

msgid "Same as"
msgstr "То же, что и"

msgid "Add"
msgstr "Добавить"

msgid "Also as aggregation target"
msgstr "Также как цель для агрегации"

msgid "any bundle"
msgstr "любой подтип"

msgid "Add selected fields"
msgstr "Добавить выбранные поля"

msgid "Select all"
msgstr "Выбрать всё"

msgid "Select none"
msgstr "Снять всё"

msgid "Select at least one field to add."
msgstr "Выберите хотя бы одно поле для добавления."

msgid "Skipped @n field(s) that could not be resolved or mapped to a type: @list"
msgstr "Пропущено полей: @n — не удалось определить свойство или сопоставить тип: @list"

# ---------------------------------------------------------------------------
# BrowseIndexForm
# ---------------------------------------------------------------------------

msgid "Apply"
msgstr "Применить"

msgid "Rebuild tree (clear cache)"
msgstr "Пересобрать дерево (очистить кэш)"

msgid "List view"
msgstr "Вид списком"

msgid "Tree view"
msgstr "Вид деревом"

msgid "The property tree for %datasource was too large to walk fully at this depth and was truncated. Lower \"Max depth\" or raise the node budget in the settings."
msgstr "Дерево свойств для %datasource оказалось слишком большим, чтобы обойти его полностью на этой глубине, и было обрезано. Уменьшите «Макс. глубину» или увеличьте лимит узлов в настройках."

msgid "No indexable properties found at this depth."
msgstr "На этой глубине не найдено свойств, доступных для индексации."

msgid "Tree cache cleared."
msgstr "Кэш дерева очищен."

msgid "You no longer have permission to modify this index."
msgstr "У вас больше нет права изменять этот индекс."

msgid "Added @n field(s) to %index."
msgstr "Добавлено полей: @n — в индекс %index."

msgid "Also created @n aggregation-target duplicate field(s) (field ID suffixed \"_agg\")."
msgstr "Также создано полей-дубликатов для агрегации: @n (с суффиксом «_agg» в имени поля)."

msgid "The following added field(s) need additional configuration before they will work correctly — edit them on the Fields tab: @list"
msgstr "Следующим добавленным полям требуется дополнительная настройка, прежде чем они заработают корректно — отредактируйте их на вкладке «Fields»: @list"

# ---------------------------------------------------------------------------
# SearchByEntityTypeForm
# ---------------------------------------------------------------------------

msgid "Target entity type"
msgstr "Целевой тип сущности"

msgid "- Select -"
msgstr "— Выберите —"

msgid "Bundle"
msgstr "Подтип (bundle)"

msgid "- Any bundle -"
msgstr "— Любой подтип —"

msgid "Search"
msgstr "Искать"

msgid "Pick a target entity type above and click Search."
msgstr "Выберите выше целевой тип сущности и нажмите «Искать»."

msgid "Index"
msgstr "Индекс"

msgid "Server"
msgstr "Сервер"

msgid "- Any server -"
msgstr "— Любой сервер —"

msgid "Index(es)"
msgstr "Индекс(ы)"

msgid "Leave empty to search every index."
msgstr "Оставьте пустым, чтобы искать по всем индексам."

msgid "No chains to this entity type were found at this depth."
msgstr "На этой глубине не найдено цепочек, ведущих к этому типу сущности."

msgid "The property tree was too large to walk fully at this depth for the following index(es), so some matches may be missing: @list. Lower \"Max depth\" won't help here — raise the node budget in the settings instead, or narrow the search."
msgstr "Дерево свойств оказалось слишком большим, чтобы обойти его полностью на этой глубине, для следующих индексов, поэтому часть совпадений может быть пропущена: @list. Уменьшение «Макс. глубины» здесь не поможет — вместо этого увеличьте лимит узлов в настройках, либо сузьте поиск."

msgid "Skipped index %index — you no longer have permission to modify it."
msgstr "Индекс %index пропущен — у вас больше нет права его изменять."

msgid "Added @n field(s) across @m index(es)."
msgstr "Добавлено полей: @n — в индексах: @m."

msgid "The following added field(s) need additional configuration before they will work correctly: @list"
msgstr "Следующим добавленным полям требуется дополнительная настройка, прежде чем они заработают корректно: @list"

